---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: 'mailto:oscar.rodriguez.diaz20@gmail.com', label: 'oscar.rodriguez.diaz20@gmail.com', external: false },
  { href: 'https://github.com/khar20', label: 'github.com/khar20', external: true },
  { href: 'https://linkedin.com/in/oscar-rodriguezdiaz', label: 'linkedin.com/in/oscar-rodriguezdiaz', external: true },
  { href: 'https://kharont.dev', label: 'kharont.dev', external: true },
];
---

<section id="contact" class="sec">
  <div class="inner">
    <div class="sh">
      <h2 class="sh-t">{t.contact.title}</h2>
      <div class="sh-l"></div>
    </div>

    <div class="contact-layout">
      <div class="contact-info">
        <div class="ci-h">{t.contact.heading}</div>
        <p class="ci-tagline">{t.contact.tagline}</p>
        <div class="ci-links">
          {
            links.map((l) => (
              <a href={l.href} class="ci-link" {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>
                <span>{l.label}</span> <span class="arr">↗</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="cf-wrap">
        <div class="cw-h">{t.contact.sendHeading}</div>
        <form class="cf" id="contactForm" novalidate data-msgs={JSON.stringify(t.contact.formMsgs)}>
          <div class="cf-row">
            <div class="cf-f">
              <label class="cf-l" for="cfName">{t.contact.form.name}</label>
              <input class="cf-i" id="cfName" name="name" type="text" required />
            </div>
            <div class="cf-f">
              <label class="cf-l" for="cfEmail">Email</label>
              <input class="cf-i" id="cfEmail" name="email" type="email" required />
            </div>
          </div>
          <div class="cf-f">
            <label class="cf-l" for="cfSubject">{t.contact.form.subject}</label>
            <input class="cf-i" id="cfSubject" name="subject" type="text" />
          </div>
          <div class="cf-f">
            <label class="cf-l" for="cfMsg">{t.contact.form.message}</label>
            <textarea class="cf-i" id="cfMsg" name="message" required></textarea>
          </div>
          <button class="cf-btn" type="submit">{t.contact.form.submit}</button>
        </form>
      </div>
    </div>
  </div>
</section>