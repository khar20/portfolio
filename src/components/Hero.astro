---

<div id="hero">
    <div class="hero-top">
        <div class="hero-text">
            <div class="hero-name">Oscar Rodríguez.</div>
            <div class="hero-role">
                <span>Software Engineer</span>
            </div>
            <p class="hero-desc">
                <span>Building.</span>
            </p>
            <div class="hero-ac">
                <a class="btn p" onclick="scrollTo('projects')">
                    <span>View work</span>
                </a>
                <a class="btn" href="#">
                    <span>Resume ↓</span>
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    #hero {
        padding: 56px 68px 48px;
        border-bottom: 1px solid var(--b1);
        animation: fadeUp 0.35s ease both;
    }

    .hero-top {
        display: flex;
        align-items: flex-start;
        gap: 36px;
        margin-bottom: 38px;
        max-width: 920px;
        margin-left: auto;
        margin-right: auto;
    }

    .hero-text {
        flex: 1;
    }

    .hero-name {
        font-size: clamp(30px, 4vw, 56px);
        font-weight: 600;
        color: var(--white);
        line-height: 1.04;
        letter-spacing: -0.5px;
        margin-bottom: 6px;
    }

    .hero-role {
        font-size: 14px;
        color: var(--teal);
        margin-bottom: 14px;
    }

    .hero-desc {
        font-family: "IBM Plex Sans", sans-serif;
        font-size: 14.5px;
        font-weight: 300;
        color: var(--text2);
        max-width: 500px;
        line-height: 1.85;
        margin-bottom: 22px;
    }

    .hero-ac {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }
</style>
