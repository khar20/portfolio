---
import { Image } from 'astro:assets';
import profile from '../assets/profile.jpg';
import { useTranslations, type Lang } from '../i18n/ui';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header id="hero">
  <div class="hero-inner">

    <div class="hero-ey">
      <div class="avail">
        <span class="sdot"></span>
        <span>{t.availability}</span>
      </div>
      <div class="ctrl-group">
        <LangSwitcher lang={lang} />
        <button id="themeBtn" aria-label="Toggle theme">◑</button>
      </div>
    </div>

    <div class="hero-top">
      <div class="hero-pic">
        <Image
          src={profile}
          alt={t.hero.portraitAlt}
          class="hero-img"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="hero-text">
        <h1 class="hero-name">Oscar Rodríguez.<span class="cur"></span></h1>
        <div class="hero-role">{t.role}</div>
        <p class="hero-desc">{t.hero.desc}</p>

        <div class="hero-langs">
          {
            t.hero.languages.map((l, i) => (
              <>
                {i > 0 && <span class="sep">|</span>}
                <span class="lang">
                  <span>{l.name}</span>
                  <span class="lang-lvl">{l.level}</span>
                </span>
              </>
            ))
          }
        </div>

        <div class="hero-ac">
          <a class="btn p" href="#projects">{t.hero.viewWork}</a>
          <a class="btn" href="#">{t.hero.resume}</a>
          <a href="https://github.com/khar20" class="soc" aria-label="GitHub" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg></a>
          <a href="https://linkedin.com/in/oscar-rodriguezdiaz" class="soc" aria-label="LinkedIn" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
          <a href="mailto:oscar.rodriguez.diaz20@gmail.com" class="soc" aria-label="Email"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-.47.21-.886.54-1.17L12 13.09 23.46 4.287c.33.284.54.7.54 1.17z"/></svg></a>
        </div>
      </div>
    </div>

    <div class="hero-bottom">
      <div class="hb-head">
        <svg class="hb-trophy" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
          <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
          <path d="M4 22h16"/>
          <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
          <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
          <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
        </svg>
        <span class="hb-label">{t.hero.recognitions}</span>
      </div>
      <ul class="hb-awards">
        {
          t.awards.map((a) => (
            <li class="award-item">
              <span class="award-rank">{a.rank}</span>
              <span class="award-name">{a.name}</span>
              <span class="award-detail">{a.detail}</span>
            </li>
          ))
        }
      </ul>
    </div>

  </div>
</header>