---
import { sections, useTranslations, type Lang } from '../i18n/ui';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div id="mob-bar">
  <div class="mb-top">
    <div class="avail">
      <span class="sdot"></span>
      <span>{t.availability}</span>
    </div>
    <div class="ctrl-group">
      <LangSwitcher lang={lang} />
      <button id="themeBtnMob" aria-label="Toggle theme">◑</button>
    </div>
  </div>
  <nav class="mb-nav" aria-label="Sections">
    {
      sections.map((s) => (
        <a href={s.href} data-sec={s.id}>{t.nav[s.id]}</a>
      ))
    }
  </nav>
</div>